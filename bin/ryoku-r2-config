#!/usr/bin/env bash
# ryoku-r2-config: write the rclone remote the release workflows upload
# through (the [ryoku] repo channels and the ISO), from the R2_* secrets in the
# environment. One place for the remote's shape, used by publish-repo.yml (the
# build and publish jobs) and build-iso-reusable.yml.
#
# With CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET set, the endpoint is an
# S3 server (Garage) behind Cloudflare Access instead of R2. Access needs its
# service-token headers on every request, and rclone has no per-remote header
# option for S3 (RCLONE_HEADER carries only one), so an rclone wrapper that
# adds them goes first on the job's PATH.
set -euo pipefail
: "${R2_ACCESS_KEY_ID:?}" "${R2_SECRET_ACCESS_KEY:?}" "${R2_ENDPOINT:?}"
mkdir -p ~/.config/rclone
if [[ -z ${CF_ACCESS_CLIENT_ID:-} ]]; then
  cat > ~/.config/rclone/rclone.conf <<EOF
[Ryoku]
type = s3
provider = Cloudflare
access_key_id = ${R2_ACCESS_KEY_ID}
secret_access_key = ${R2_SECRET_ACCESS_KEY}
endpoint = ${R2_ENDPOINT}
# The scoped R2 token has Object Read+Write only, not bucket-level perms;
# without this rclone calls HeadBucket/CreateBucket and 403s. The bucket
# already exists, so skip the check.
no_check_bucket = true
EOF
  chmod 600 ~/.config/rclone/rclone.conf
  exit 0
fi

: "${CF_ACCESS_CLIENT_SECRET:?}"
cat > ~/.config/rclone/rclone.conf <<EOF
[Ryoku]
type = s3
provider = Other
access_key_id = ${R2_ACCESS_KEY_ID}
secret_access_key = ${R2_SECRET_ACCESS_KEY}
endpoint = ${R2_ENDPOINT}
region = garage
force_path_style = true
no_check_bucket = true
# Cloudflare refuses request bodies over 100 MB; 50M parts stay under it.
upload_cutoff = 50M
chunk_size = 50M
# Cloudflare rewrites Accept-Encoding on the way to the origin, so a signature
# covering it no longer matches what Garage receives.
sign_accept_encoding = false
EOF
chmod 600 ~/.config/rclone/rclone.conf

wrapper_dir=~/.local/share/ryoku-rclone/bin
real=$(command -v rclone)
[[ $real != "$wrapper_dir/rclone" ]] || exit 0
mkdir -p "$wrapper_dir"
# sign_accept_encoding arrived after the rclone Ubuntu packages; an older one
# still signs Accept-Encoding on every download, so a pinned release replaces it.
if ! "$real" help backend s3 2>/dev/null | grep -q sign-accept-encoding; then
  version=v1.75.2
  case $(uname -m) in
    x86_64) arch=amd64 sum=349ac8fba6ff65d6247043f1750cdcb518ec5d500ef91463a10d37c0ccdf3702 ;;
    aarch64) arch=arm64 sum=7e1e8d69654941b7b7df84ee74c5f7fb09cce7d5496947fb7bf16b55ff427d10 ;;
    *) echo "ryoku-r2-config: no pinned rclone for $(uname -m)" >&2; exit 1 ;;
  esac
  zip="$wrapper_dir/rclone-$version-linux-$arch.zip"
  curl -fsSL -o "$zip" "https://downloads.rclone.org/$version/rclone-$version-linux-$arch.zip"
  echo "$sum  $zip" | sha256sum -c --quiet
  unzip -q -o -j "$zip" "rclone-$version-linux-$arch/rclone" -d "$wrapper_dir/pinned"
  rm -f "$zip"
  real="$wrapper_dir/pinned/rclone"
fi
cat > "$wrapper_dir/rclone" <<EOF
#!/usr/bin/env bash
exec "$real" --header "CF-Access-Client-Id: ${CF_ACCESS_CLIENT_ID}" --header "CF-Access-Client-Secret: ${CF_ACCESS_CLIENT_SECRET}" "\$@"
EOF
chmod 700 "$wrapper_dir/rclone"
if [[ -n ${GITHUB_PATH:-} ]]; then
  echo "$wrapper_dir" >> "$GITHUB_PATH"
else
  echo "ryoku-r2-config: put $wrapper_dir first on PATH" >&2
fi
