[Unit]
Description=Ryoku first-boot setup
# It replaces initial-setup on tty1: the wizard creates the accounts itself.
Conflicts=initial-setup.service getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service NetworkManager.service asahi-extras-firstboot.service
Before=getty@tty1.service display-manager.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/ryoku-asahi/ryoku-firstboot-session
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
