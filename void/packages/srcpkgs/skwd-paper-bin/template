# Template file for 'skwd-paper-bin'
pkgname=skwd-paper-bin
version=1.0.0beta23
revision=2
archs="x86_64*"
build_style=cargo
_paper_commit=7f9c17277a589cdd11113771b0bde0a6bb2b7d38
_ffmpeg_version=9.0.1
wrksrc="skwd-paper-${_paper_commit}"
skip_extraction="ffmpeg-${_ffmpeg_version}.tar.xz"
hostmakedepends="cargo-auditable clang curl nasm patchelf pkg-config tar xz"
makedepends="Vulkan-Headers alsa-lib-devel libdav1d-devel libdrm-devel
 pulseaudio-devel libva-devel libyuv-devel shaderc vulkan-loader-devel
 wayland-devel zlib-devel"
depends="alsa-lib libdav1d libdrm libgcc libglvnd libpulseaudio pulseaudio-utils
 libva libxkbcommon libyuv shaderc vulkan-loader wayland zlib"
short_desc="Wallpaper Engine renderer backend for Ryogami"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://github.com/liixini/skwd-paper"
distfiles="https://github.com/jccr/skwd-paper/archive/${_paper_commit}.tar.gz
 https://ffmpeg.org/releases/ffmpeg-${_ffmpeg_version}.tar.xz"
checksum="d7b2449a99d2987771284d00989f3ca98e5f060b13a56b0b77bd2490c4305acf
 cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635"
provides="skwd-paper-${version}_${revision}"
conflicts="skwd-paper>=0"
nocross=yes

do_build() {
	local ffmpeg_prefix="${PWD}/.xbps-ffmpeg"

	mkdir -p vendor-ffmpeg
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/ffmpeg-${_ffmpeg_version}.tar.xz" \
		vendor-ffmpeg/
	./packaging/build-ffmpeg-runtime.sh "${ffmpeg_prefix}"

	export FFMPEG_DIR="${ffmpeg_prefix}"
	export PKG_CONFIG_PATH="${ffmpeg_prefix}/lib/pkgconfig"
	cargo auditable build --release --locked --target "${RUST_TARGET}" --workspace
}

do_install() {
	# package-stage.sh requires a fresh destination after xbps-src populates DESTDIR.
	rm -rf .xbps-stage
	SKWD_PAPER_BIN_DIR="${PWD}/target/${RUST_TARGET}/release" \
		./scripts/package-stage.sh "${PWD}/.xbps-stage"
	cp -a .xbps-stage/. "${DESTDIR}/"

	vmkdir usr/lib/skwd-paper
	vcopy ".xbps-ffmpeg/lib/*.so*" usr/lib/skwd-paper
	vlicense .xbps-ffmpeg/share/licenses/ffmpeg/COPYING.LGPLv2.1 \
		ffmpeg-COPYING.LGPLv2.1
	vlicense .xbps-ffmpeg/share/licenses/ffmpeg/LICENSE.md ffmpeg-LICENSE.md
}
